## to check if a number is prime or not

def prime(n):
    if n<=1:
      return False
    
    for i in range(2,int(n**0.5)+1):
        if n%i==0: 
           return False
    return True
        
n=int(input("enter a number:"))
if prime(n):
  print("It is a prime number:")
else:
  print("It is not a prime number:")          
        
