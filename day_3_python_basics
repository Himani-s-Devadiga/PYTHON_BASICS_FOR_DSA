# ==========================================
# Program 8: Check Data Type
# ==========================================

user = input("Enter a value: ")

try:
    int(user)
    print("It is an Integer")
except ValueError:
    try:
        float(user)
        print("It is a Float")
    except ValueError:
        print("It is a String")


# ==========================================
# Program 9: Calculator
# ==========================================

a = int(input("Enter first value: "))
b = int(input("Enter second value: "))
operator = input("Enter operator (+,-,*,/,//,%,^): ")

if operator == "+":
    print(a + b)
elif operator == "-":
    print(a - b)
elif operator == "*":
    print(a * b)
elif operator == "/":
    print(a / b)
elif operator == "//":
    print(a // b)
elif operator == "%":
    print(a % b)
elif operator == "^":
    print(a ** b)
else:
    print("Invalid Operator")


